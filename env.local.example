# ── Contact form (Resend) ─────────────────────────────────────────────
# 1. Create a free account at https://resend.com
# 2. Create an API key (Dashboard → API Keys) and paste it below.
# 3. Copy this file to `.env.local` (never commit .env.local).

RESEND_API_KEY=re_your_api_key_here

# Where enquiries are delivered:
CONTACT_EMAIL=hello@connectcabsindia.com

# Sender address.
# Until the domain is verified in Resend, leave this as the shared sender below.
# Once you verify connectcabsindia.com in Resend (Dashboard → Domains),
# change this to something like: "ConnectCabs <hello@connectcabsindia.com>"
CONTACT_FROM=ConnectCabs <onboarding@resend.dev>
